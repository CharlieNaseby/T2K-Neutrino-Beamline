   IsMagnetElement[x_] := If[x[[2]]==2||x[[2]]==4||x[[2]]==22,1,0];
 
   SetMagType[magdat_] := Module[{mag,type}, mag=magdat[[1]]; type=magdat[[2]]; MagType[mag] = type;];
 
   FxMagList = Select[Thread[LINE[{"NAME",   "TYPE"}]], IsMagnetElement];
 
   Scan[SetMagType, FxMagList];
 
   GetMagnetParam[name_, param_] := Module[{elem},
                                           elem = SetElement[name];
                                           If[Length[elem]==3, param /. Part[elem,3], 0.0]];
 
   BENDPARAMS = {"ANGLE", "K0", "F1", "DX", "DY"};
   QUADPARAMS = {"K1",    "F1", "F2", "DX", "DY"};
   MULTPARAMS = {"ANGLE", "K0", "K1", "K2", "K3", "SK0", "SK1", "SK2", "SK3", "F1", "F2", "DX", "DY"};
 
   GetMagParams[type_] := Switch[type
