                                   Do[FxMagParamIn[sname, paramlist[[j]]]=GetMagnetParam[sname, paramlist[[j]]];
                                      FxMagParamIn[sname, paramlist[[j]]//"fit"]=0,{j,Length[paramlist]}]];
                                Do[FxMagParamIn[name, paramlist[[j]]]=GetMagnetParam[sname, paramlist[[j]]];
                                   FxMagParamIn[name, paramlist[[j]]//"fit"]=0,{j,Length[paramlist]}]];
 
