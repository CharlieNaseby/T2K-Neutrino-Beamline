                                BENDPARAMS
                                ,4,
                                QUADPARAMS
                                ,22,
                                MULTPARAMS
                                ,_, {}];
 
   DefFxMagParamIn[x_] := Module[{name="", type=0, paramlist={}, sname=""},
                                name = x[[1]]; type = x[[2]]; paramlist=GetMagParams[type]; sname = LINE["ELEMENT", name];
